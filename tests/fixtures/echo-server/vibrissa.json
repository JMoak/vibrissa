{
  "$schema": "../../../schema/vibrissa.schema.json",
  "servers": {
    "echo": { "cmd": "node", "args": ["server/index.js"], "cwd": "." }
  },
  "defaultServer": "echo",
  "globs": ["cases/**/*.json", "!cases/**/*.fail.json"],
  "manifest": "tests/__manifest__.json",
  "timeoutMs": 3000,
  "failFast": false,
  "profiles": {
    "ci": { "check": true, "reporters": ["console", "junit"] },
    "legacy": {
      "servers": { "echo": { "protocol": "legacy" } },
      "excludeTags": ["tasks"]
    }
  }
}
